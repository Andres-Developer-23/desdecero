{
  "name": "desdecero",
  "version": "1.2.0",
  "private": true,
  "description": "Curso interactivo para aprender Python desde cero, en español y en el navegador.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run format:check && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "codemirror": "5.65.21",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "skulpt": "1.2.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=20"
  }
}
